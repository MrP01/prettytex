%----------------------------------------------------------------------------------------------------------------------
% Environments
%
% | environment | description |
% |-------------|-------------|
% | leftbar     |
%----------------------------------------------------------------------------------------------------------------------
\renewenvironment{leftbar}[1][\hsize]{
    \def\FrameCommand{
        {\color{themecolor}\vrule width 3pt}%
        \hspace{0pt}
        \fboxsep=.8cm\colorbox{lightgreybg}%
    }
    \MakeFramed{\hsize#1\advance\hsize-\width\FrameRestore}
}{\endMakeFramed}



%----------------------------------------------------------------------------------------------------------------------
% Macros
%
% | macro          | arguments                | description                                           |
% |----------------|--------------------------|-------------------------------------------------------|
% | wrapthm        | theorem                  | wrap a theorem with colour (adds background colour)   |
% | miniwrap       | theorem                  | wrap a theorem with coloured outline only             |
% | declareEnvList | theorem, counter,        | when referencing to an item of the defined list,      |
% |                | theoremname (uppercase), | instead of getting item, you get <theoremname>.<item> |
% |                | theoremname (lowercase)  | see the documenation for more                         |
%
%----------------------------------------------------------------------------------------------------------------------
\newcommand{\wrapthm}[2]{%
    \tcolorboxenvironment{#1}{enhanced jigsaw,
        enhanced jigsaw, colframe=#2!50,%
        ,fonttitle=\bfseries\itshape,colbacktitle=#2!20,%
        borderline={0.5mm}{0mm}{#2!50},%
        colback=#2!5
    }
}

\newcommand{\miniwrap}[2]{%
    \tcolorboxenvironment{#1}{enhanced jigsaw,
        colframe=#2!50,%
        ,fonttitle=\bfseries\itshape,colbacktitle=#2!20,%
        borderline={0.5mm}{0mm}{#2!50},%
        colback=white
    }
}

\newcommand{\envList}[3]{
    \newlist{#1list}{enumerate}{1}
    \setlist[#1list]{label=(\roman{#1listi}), ref=#2.(\roman{#1listi})}
    \Crefname{list#1}{#3}{#3s}
    \Crefname{#1listi}{#3}{#3s}
    \crefname{list#1}{\MakeLowercase{#3}}{\MakeLowercase{#3}s}
    \crefname{#1listi}{\MakeLowercase{#3}}{\MakeLowercase{#3}s}
    \addtotheorempostheadhook[#1]{\crefalias{#1listi}{list#1}}
}
