%----------------------------------------------------------------------------------------------------------------------
% Overset relations
%
% prettytexMath:
%
% | macro            | expands to |
% |------------------|------------|
% | AlmostEverywhere | mathrm{ae} |
%
% macros:
%
% | macro | arguments | description |
% |
% | hateq         |                       | equal sign with hat (used for congruence and such)                   |
% | refrel        | reference, expression | overset the refence to the expression                                |
% | refqual       | reference             | shortcut of refrel, but with permant = as second argument            |
% | refleq        | reference             | shortcut of refrel, but with \leq as permanent second argument       |
% | refle         | reference             | shortcut of refrel, but with < as permanent second argument          |
% | refgeq        | reference             | shortcut of refrel, but with \geq as permanent second argument       |
% | refge         | reference             | shortcut of refrel, but with > as permanent second argument          |
% | refimpl       | reference             | shortcut of refrel, but with \implies as permanent second argument   |
% | refimpliedb   | reference             | shortcut of refrel, but with \impliedby as permanent second argument |
% | refeqv        | reference             | shortcut of refrel, but with \eqv as permanent second argument       |
% | refiso        | reference             | shortcut of refrel, but with \cong as permanent second argument      |
% | eqrefrel      | reference, expression | overset the equation reference to the expression                     |
% | eqrefqual     | reference             | same as refqual but for equation reference                           |
% | eqrefleq      | reference             | same as refleq but for equation reference                            |
% | eqrefle       | reference             | same as refle but for equation reference                             |
% | eqrefgeq      | reference             | same as refgeq but for equation reference                            |
% | eqrefge       | reference             | same as refge but for equation reference                             |
% | eqrefimpl     | reference             | same as refimpl but for equation reference                           |
% | eqrefimpliedb | reference             | same as refimpliedb but for equation reference                       |
% | eqrefeqv      | reference             | same as refeqv but for equation reference                            |
% | eqrefiso      | reference             | same as refiso but for equation reference                            |
% | aerel         | expression            | oversets AlmostEverywhere to the expression                          | 
% | aeeq          |                       | \aerel{=}                                                            |
% | aequal        |                       | alias to aeeq                                                        |
% | aeleq         |                       | \aerel{\leq}                                                         |
% | aele          |                       | \aerel{<}                                                            |
% | aegeq         |                       | \aerel{\geq}                                                         |
% | aege          |                       | \aerel{>}                                                            |
%
%----------------------------------------------------------------------------------------------------------------------
% prettytexMath
\newcommand{\prettytexMathAlmostEverywhere}{\mathrm{ae}}

% macros
\newcommand{\hateq}{\hat{=}}

% relations with reference
\newcommand{\refrel}[2]{\oset{\text{\ref{#1}}}{#2}}
\newcommand{\refqual}[1]{\refrel{#1}{=}}
\newcommand{\refleq}[1]{\refrel{#1}{\leq}}
\newcommand{\refle}[1]{\refrel{#1}{<}}
\newcommand{\refgeq}[1]{\refrel{#1}{\geq}}
\newcommand{\refge}[1]{\refrel{#1}{>}}
\newcommand{\refimpl}[1]{\refrel{#1}{\implies}}
\newcommand{\refimpliedb}[1]{\refrel{#1}{\impliedby}}
\newcommand{\refeqv}[1]{\refrel{#1}{\eqv}}
\newcommand{\refiso}[1]{\refrel{#1}{\cong}}

% relations with eqreference
\newcommand{\eqrefrel}[2]{\oset{\text{\eqref{#1}}}{#2}}
\newcommand{\eqrefqual}[1]{\eqrefrel{#1}{=}}
\newcommand{\eqrefleq}[1]{\eqrefrel{#1}{\leq}}
\newcommand{\eqrefle}[1]{\eqrefrel{#1}{<}}
\newcommand{\eqrefgeq}[1]{\eqrefrel{#1}{\geq}}
\newcommand{\eqrefge}[1]{\eqrefrel{#1}{>}}
\newcommand{\eqrefimpl}[1]{\eqrefrel{#1}{\implies}}
\newcommand{\eqrefimpliedb}[1]{\eqrefrel{#1}{\impliedby}}
\newcommand{\eqrefeqv}[1]{\eqrefrel{#1}{\eqv}}
\newcommand{\eqrefiso}[1]{\eqrefrel{#1}{\cong}}

% almost everywhere relations
\newcommand{\aerel}[1]{\oset{\prettytexMathAlmostEverywhere}{#1}}
\newcommand{\aeeq}{\aerel{=}}
\newcommand{\aequal}{\aeeq}
\newcommand{\aeleq}{\aerel{\leq}}
\newcommand{\aele}{\aerel{<}}
\newcommand{\aegeq}{\aerel{\geq}}
\newcommand{\aege}{\aerel{>}}