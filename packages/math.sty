\newcommand*{\longleadsto}[1]{
  \tikzexternaldisable
  \begin{tikzpicture}
    \draw [->, line join=round, decorate, decoration={
          zigzag,
          segment length=4,
          amplitude=.9,
          post=lineto,
          post length=2pt}] (0,0) -- (#1,0);
  \end{tikzpicture}
  \tikzexternalenable
}

\newcommand{\rtrf}[1]{%
  \tikzexternaldisable%
  \begin{tikzpicture}%
    \draw [->, line join=round, decorate, decoration={%
          zigzag,%
          segment length=4,%
          amplitude=.9,%
          post=lineto,%
          post length=2pt}] (0,0) -- (1.5cm,0)%
    node[midway,above]{$\substack{#1}$};%
  \end{tikzpicture}%
  \tikzexternalenable%
}

%----------------------------------------------------------------------------------------------------------------------
% Number theory
%
% prettytexMath:
%
% | macro                 | expands to |
% |-----------------------|------------|
% | LeastCommonMultiple   | lcm        |
% | GreatestCommonDivisor | gcd        |
%
% macros:
%
% | macro       | arguments              | description                        |
% |-------------|------------------------|------------------------------------|
% | stirlingone | expression, expression | stirling number of the first kind  |
% | stirlingtwo | expression, expression | stirling number of the second kind |
% | cycle       | array                  | cycle notation for permutation     |
%
% operators
%
% | operator | description                     |
% |--------------------------------------------|
% | lcm      | least common multiple           |
% | kgv      | alias for lcm (german spelling) |
% | kgB      | alias for lcm (german spelling) |
% | gcd      | greatest common divisor         |
% | ggt      | alias for gcd (german spelling) |
% | ggT      | alias for gcd (german spelling) |
% 
%----------------------------------------------------------------------------------------------------------------------
\let\gcd\relax
%prettytexMath
\newcommand{\prettytexMathLeastCommonMultiple}{lcm}
\newcommand{\prettytexMathGreatestCommonDivisor}{gcd}

% macros
\newcommand{\stirlingone}[2]{\begin{bmatrix}#1\\#2\end{bmatrix}}
\newcommand{\stirlingtwo}[2]{\begin{Bmatrix}#1\\#2\end{Bmatrix}}
\newcommand{\cycle}[1]{\begin{pmatrix}#1\end{pmatrix}}

% operators
\DeclareMathOperator{\lcm}{\qopname \relax m{\prettytexMathLeastCommonMultiple}}
