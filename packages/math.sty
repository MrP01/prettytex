%----------------------------------------------------------------------------------------------------------------------
% Sequences and limits
%
% | macro      | arguments  | description                                                     |
% |------------|------------|-----------------------------------------------------------------|
% | seqn       | expression | shortcut for family notation (x_n)_{n\in \N} of sequence x      |
% | seqnz      | expression | same as seqn but with \N_0 as indexing set                      |
% | seqk       | expression | same as seqn but with k as index variable                       |
% | seqkz      | expression | same as seqnz but with k as index variable                      |
% | iseq       | expression | arbitary family (x_i)_{i\in I}                                  |
% | jseq       | expression | same as iseq but with J as indexing set and j as index variable |
% | net        | expression | family notation (x_\lambda)_{\lambda\in\Lambda} for net x       |
% | Kappa      |            | uppercase kappa (just K, but mathrm'd instead of text)          |
% | subnet     | expression | subnet of net x                                                 |
% | limh       |            | limit as h goes to 0                                            |
% | limt       |            | limit as t goes to 0                                            |
% | limx       |            | limit as x goes to x0                                           |
% | limt       |            | limit as z goes to z0                                           |
% | limn       |            | limit as n goes to infinity                                     |
% | limk       |            | limit as k goes to infinity                                     |
% | liminfn    |            | limit inferior as n goes to infinity                            |
% | limsupn    |            | limit superior as n goes to infinity                            |
% | liminfk    |            | limit inferior as k goes to infinity                            |
% | limsupk    |            | limit superior as k goes to infinity                            |
% | infn       |            | infimum over n in the naturals                                  |
% | infk       |            | infimum over k in the naturals                                  |
% | supn       |            | supremum over n in the naturals                                 |
% | supk       |            | supremum over k in the naturals                                 |
%
%----------------------------------------------------------------------------------------------------------------------
\newcommand{\seqn}[1]{(#1_n)_{n\in\N}}
\newcommand{\seqnz}[1]{(#1_n)_{n\in\N_0}}
\newcommand{\seqk}[1]{(#1_k)_{k\in\N}}
\newcommand{\seqkz}[1]{(#1_k)_{k\in\N_0}}
\newcommand{\iseq}[1]{(#1_i)_{i\in I}}
\newcommand{\jseq}[1]{(#1_j)_{j\in J}}
\newcommand{\net}[1]{(#1_\lambda)_{\lambda\in\Lambda}}
\newcommand{\Kappa}{\mathrm{K}}
\newcommand{\subnet}[1]{(#1_{\lambda_\kappa})_{\kappa\in\Kappa}}

\newcommand{\limh}{\lim_{h\to 0}}
\newcommand{\limt}{\lim_{t\to 0}}
\newcommand{\limx}{\lim_{x\to x_0}}
\newcommand{\limz}{\lim_{z\to z_0}}
\newcommand{\limn}{\lim_{n\to \infty}}
\newcommand{\limk}{\lim_{k\to \infty}}
\newcommand{\liminfn}{\liminf_{n\to\infty}}
\newcommand{\limsupn}{\limsup_{n\to\infty}}
\newcommand{\liminfk}{\liminf_{k\to\infty}}
\newcommand{\limsupk}{\limsup_{k\to\infty}}
\newcommand{\infn}{\inf_{n\in\N}}
\newcommand{\infk}{\inf_{k\in\N}}
\newcommand{\supn}{\sup_{n\in\N}}
\newcommand{\supk}{\sup_{k\in\N}}

