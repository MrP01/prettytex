% dot products
\newcommand{\dotp}[2]{\langle#1,#2\rangle}
\renewcommand{\ldotp}[2]{\left\langle#1,#2\right\rangle}
\newcommand{\dotpc}{\dotp{\prettytexMathDotProductPlaceholder}{\prettytexMathDotProductPlaceholder}}

\NewDocumentCommand{\Lpdotp}{O{\prettytexMathLpDefaultExponent} o m m}{%
\IfNoValueTF{#2}{\dotp{#3}{#4}_{L^{#1}}}{\dotp{#3}{#4}_{L^{#1}(#2)}}}

\NewDocumentCommand{\lLpdotp}{O{\prettytexMathLpDefaultExponent} o m m}{%
\IfNoValueTF{#2}{\ldotp{#3}{#4}_{L^{#1}}}{\ldotp{#3}{#4}_{L^{#1}(#2)}}}

\NewDocumentCommand{\Lpdotpc}{O{\prettytexMathLpDefaultExponent} o}{%
\IfNoValueTF{#2}%
{\Lpdotp[#1]{\prettytexMathDotProductPlaceholder}{\prettytexMathDotProductPlaceholder}}%
{\Lpdotp[#1][#2]{\prettytexMathDotProductPlaceholder}{\prettytexMathDotProductPlaceholder}}}

% norms
\NewDocumentCommand{\norm}{o m}{\IfNoValueTF{#1}{\|#2\|}{\|#1\|_{#1}}}
\NewDocumentCommand{\lnorm}{o m}{\IfNoValueTF{#1}{\left\|#2\left\|}{\left\|#1\left\|_{#1}}}
\newcommand{\normc}{\norm{\prettytexMathNormPlaceholder}}

\newcommand{\inorm}[1]{\norm{#1}_\infty}
\newcommand{\linorm}[1]{\lnorm{#1}_\infty}
\newcommand{\inormc}{\norm{\prettytexMathNormPlaceholder}}

\NewDocumentCommand{\pnorm}{O{\prettytexMathLpDefaultExponent} m}{\norm{#2}_{#1}}
\NewDocumentCommand{\lpnorm}{O{\prettytexMathLpDefaultExponent} m}{\lnorm{#2}{#1}}
\NewDocumentCommand{\pnormc}{O{\prettytexMathLpDefaultExponent}}{\pnorm[#1]{\prettytexMathNormPlaceholder}}

\NewDocumentCommand{\Lpnorm}{O{\prettytexMathLpDefaultExponent} o m}{%
\IfNoValueTF{#2}{\norm{#3}_{L^{#1}}}{\norm{#3}_{L^{#1}(#2)}}}

\NewDocumentCommand{\lLpnorm}{O{\prettytexMathLpDefaultExponent} o m}{%
\IfNoValueTF{#2}{\lnorm{#3}_{L^{#1}}}{\lnorm{#3}_{L^{#1}(#2)}}}

\NewDocumentCommand{\Lpnormc}{O{\prettytexMathLpDefaultExponent} o}{%
\IfNoValueTF{#2}{\Lpnorm[#1]{\prettytexMathNormPlaceholder}}{\Lpnorm[#1][#2]{\prettytexMathNormPlaceholder}}}

