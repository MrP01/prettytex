%----------------------------------------------------------------------------------------------------------------------
% Formatting and such
%
% macros:
%
% | macro   | arguments              | description                                                      |
% |---------|------------------------|------------------------------------------------------------------|
% | qqtext  | text                   | meant to be used in equations, results in: qquad <text> qquad    |
% | qtext   | text                   | same as qqtext, but with quad instead of qquad                   |
% | bar     | expression             | overline the argument (motivation was bar is used when speaking) |
% | ubar    | expression             | alias for underline                                              |
% | oset    | expression, expression | alias for overset, set #1 above #2                               |
% | uset    | expression, expression | alias for underset, set #1 below #2                              |
% | obra    | expression             | put brace above #1, scales automatically                         |
% | ubra    | expression             | put brace below #1, scales automatically                         |
% | parenth | expression             | macro name is an abbreviation of parenthesis, put #1 in          | 
% |         |                        | automatically scaled parenthesis                                 | 
% | eqv     |                        | equivalence arrow (logic)
%
%----------------------------------------------------------------------------------------------------------------------
\newcommand{\qqtext}[1]{\qquad\text{#1}\qquad}
\newcommand{\qtext}[1]{\quad\text{#1}\quad}
\renewcommand{\bar}[1]{\overline{#1}}
\newcommand{\ubar}[1]{\underline{#1}}
\newcommand{\oset}[2]{\overset{#1}{#2}}
\newcommand{\uset}[2]{\underset{#1}{#2}}
\newcommand{\obra}[1]{\overbrace{#1}}
\newcommand{\ubra}[1]{\underbrace{#1}}
\newcommand{\parenth}[1]{\left(#1\right)}
\newcommand{\eqv}{\Longleftrightarrow}

%----------------------------------------------------------------------------------------------------------------------
% Sets
%
% prettytexMath:
%
% | macro      | expands to |
% |------------|------------|
% | Complement | mathsf{c}  |
%
% macros:
%
% | macro      | arguments  | description                                                                 |
% |------------|------------|-----------------------------------------------------------------------------|
% | set        | expression | shortcut for set builder notation, removes need to manually write \{ and \} |
% | sm         |            | alias for setminus                                                          |
% | compl      |            | place the complement in the superscript of the previous expression          |
% | eset       |            | alias for emptyset                                                          |
% | sset       |            | alias for subseteq                                                          |
% | psset      |            | alias for subset                                                            |
% | Sset       |            | alias for supseteq                                                          |
% | pSset      |            | alias for supset                                                            |
% | inv        |            | places -1 in the superscript of the previous expression                     |
%
%----------------------------------------------------------------------------------------------------------------------
%prettytexMath
\newcommand{\prettytexMathComplement}{\mathsf{c}}

% macros
\newcommand{\set}[1]{\left\{#1\right\}}
\newcommand{\sm}{\setminus}
\newcommand{\compl}{^\prettytexMathComplement}
\newcommand{\eset}{\emptyset}
\newcommand{\sset}{\subseteq}
\newcommand{\psset}{\subset}
\newcommand{\Sset}{\supseteq}
\newcommand{\pSset}{\supset}
\newcommand{\inv}{^{-1}}

