\ProvidesPackage{prettytex/mathematicians}
\RequirePackage{prettytex/base}

%----------------------------------------------------------------------------------------------------------------------
% Macros
%
% | macro            | arguments            | description                                                       |
% |------------------|----------------------|-------------------------------------------------------------------|
% | newMathematician | text (o), text, link | creates a new command that either has the name #2 or #1, if #1 is |
% |                  |                      | supplied. #3 links to the wikipedia page of the mathematician     |
%
%----------------------------------------------------------------------------------------------------------------------
\NewDocumentCommand{\newMathematician}{o m m}{
    \IfNoValueTF{#1}
    {\expandafter\newcommand\csname #2\endcsname{\textsl{\href{#3}{#2}}\xspace}}
    {\expandafter\newcommand\csname #1\endcsname{\textsl{\href{#3}{#2}}\xspace}}
}
    
