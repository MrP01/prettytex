\DeclareTranslation{English}{Example}{Example}
\DeclareTranslation{English}{Examples}{Examples}
\DeclareTranslation{English}{Axiom}{Axiom}
\DeclareTranslation{English}{Axioms}{Axioms}
\DeclareTranslation{English}{Principle}{Principle}
\DeclareTranslation{English}{Principles}{Principles}

\DeclareTranslation{English}{PluralTheorem}{Theorems}
\DeclareTranslation{English}{PluralLemma}{Lemmas}
\DeclareTranslation{English}{PluralProposition}{Propositions}
\DeclareTranslation{English}{PluralCorollary}{Corollaries}
\DeclareTranslation{English}{PluralDefinition}{Definitions}
\DeclareTranslation{English}{PluralRemark}{Remarks}
\DeclareTranslation{English}{PluralRemarks}{Remarks}
\DeclareTranslation{English}{PluralExample}{Examples}
\DeclareTranslation{English}{PluralExamples}{Examples}
\DeclareTranslation{English}{PluralAxiom}{Axioms}
\DeclareTranslation{English}{PluralAxioms}{Axioms}
\DeclareTranslation{English}{PluralPrinciple}{Principles}
