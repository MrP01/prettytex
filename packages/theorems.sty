%----------------------------------------------------------------------------------------------------------------------
% @package: prettytex/theorems
%
% @version: 1.2.1 @ refactor
% @author : lphilmossb
%
% @description: 
% 
% Provides a list of common math environments like theorems, definitions, lemmata etc, and a few not so common
% ones like principle or axiom. Furthermore, some environments have a plural version, like examples when you
% want to provide multiple examples in a single block. However, when you reference them via the examples list,
% you still get the same behaviour as for the singular list, i.e. instead of Examples 3.(ii), the result is 
% Example 3.(ii). Referencing multiple elements of an examples list then gives Examples 3.(ii) and 3.(iii), just
% like the default behaviour of cleveref.
%
%----------------------------------------------------------------------------------------------------------------------
\ProvidesPackage{prettytex/theorems}
\RequirePackage{prettytex/base}
\RequirePackage{prettytex/boxes}

% MikTeX is annoying, for some reason this is required on Windows
% thanks, Microslop
% \makeatletter
% \renewcommand\thmt@autorefsetup{%
% \@xa\def\csname\thmt@envname autorefname\@xa\endcsname\@xa{\thmt@thmname}%
% }
% \makeatletter
% This messes with cleveref, however, this will be automatically fixed anyway, whenever MiKTex updates 
% thmtools, since the upstream already contains the fix

