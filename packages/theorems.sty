\DeclareTranslation{German}{Axiom}{Axiom}
\DeclareTranslation{German}{Axioms}{Axiome}
\DeclareTranslation{German}{Principle}{Prinzip}
\DeclareTranslation{German}{Principles}{Prinzipien}

