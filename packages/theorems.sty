\DeclareTranslation{German}{Theorem}{Satz}
\DeclareTranslation{German}{Lemma}{Lemma}
\DeclareTranslation{German}{Proposition}{Proposition}
\DeclareTranslation{German}{Corollary}{Korollar}
\DeclareTranslation{German}{Definition}{Definition}
\DeclareTranslation{German}{Remark}{Bemerkung}
\DeclareTranslation{German}{Remarks}{Bemerkungen}
\DeclareTranslation{German}{Example}{Beispiel}
