%----------------------------------------------------------------------------------------------------------------------
% Colours
%----------------------------------------------------------------------------------------------------------------------
\newcommand{\theoremcolour}{themecolor3}
\newcommand{\definitioncolour}{themecolor2}
\newcommand{\lemmacolour}{pastelpurple}
\newcommand{\corollarycolour}{pastelpink}
\newcommand{\axiomcolour}{themecolor4}
\newcommand{\principlecolour}{darkred}

%----------------------------------------------------------------------------------------------------------------------
% Environment definitions
%----------------------------------------------------------------------------------------------------------------------
\newtheorem{theorem}{\protect\GetTranslation{Theorem}}[section]
\newtheorem{corollary}[theorem]{\protect\GetTranslation{Corollary}}
\newtheorem{lemma}[theorem]{\protect\GetTranslation{Lemma}}
\newtheorem{proposition}[theorem]{\protect\GetTranslation{Proposition}}

\theoremstyle{definition}
\newtheorem{definition}[theorem]{\protect\GetTranslation{Definition}}
\newtheorem{axiom}[theorem]{\protect\GetTranslation{Axiom}}
\newtheorem{axioms}[theorem]{\protect\GetTranslation{Axioms}}
\newtheorem{principle}[theorem]{\protect\GetTranslation{Principle}}
\newtheorem{principles}[theorem]{\protect\GetTranslation{Principles}}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{\protect\GetTranslation{Remark}}
\newtheorem{remarks}[theorem]{\protect\GetTranslation{Remarks}}
\newtheorem*{remark*}{\protect\GetTranslation{Remark}}
\newtheorem{example}[theorem]{\protect\GetTranslation{Example}}
\newtheorem{examples}[theorem]{\protect\GetTranslation{Examples}}
\newtheorem*{example*}{\protect\GetTranslation{Example}}

\Crefname{theorem}{\GetTranslation{Theorem}}{\GetTranslation{PluralTheorem}}
\Crefname{corollary}{\GetTranslation{Corollary}}{\GetTranslation{PluralCorollary}}
\Crefname{lemma}{\GetTranslation{Lemma}}{\GetTranslation{PluralLemma}}
\Crefname{proposition}{\GetTranslation{Proposition}}{\GetTranslation{PluralProposition}}
\Crefname{definition}{\GetTranslation{Definition}}{\GetTranslation{PluralDefinition}}
\Crefname{axiom}{\GetTranslation{Axiom}}{\GetTranslation{PluralAxiom}}
\Crefname{axioms}{\GetTranslation{Axioms}}{\GetTranslation{PluralAxioms}}
\Crefname{principle}{\GetTranslation{Principle}}{\GetTranslation{PluralPrinciple}}
\Crefname{principles}{\GetTranslation{Principles}}{\GetTranslation{PluralPrinciples}}
\Crefname{remark}{\GetTranslation{Remark}}{\GetTranslation{PluralRemarks}}
\Crefname{remarks}{\GetTranslation{Remarks}}{\GetTranslation{PluralRemarks}}
\Crefname{example}{\GetTranslation{Example}}{\GetTranslation{PluralExample}}
\Crefname{examples}{\GetTranslation{Examples}}{\GetTranslation{PluralExamples}}

\crefname{theorem}{\GetTranslation{Theorem}}{\GetTranslation{PluralTheorem}}
\crefname{corollary}{\GetTranslation{Corollary}}{\GetTranslation{PluralCorollary}}
\crefname{lemma}{\GetTranslation{Lemma}}{\GetTranslation{PluralLemma}}
\crefname{proposition}{\GetTranslation{Proposition}}{\GetTranslation{PluralProposition}}
\crefname{definition}{\GetTranslation{Definition}}{\GetTranslation{PluralDefinition}}
\crefname{axiom}{\GetTranslation{Axiom}}{\GetTranslation{PluralAxiom}}
\crefname{axioms}{\GetTranslation{Axioms}}{\GetTranslation{PluralAxioms}}
\crefname{principle}{\GetTranslation{Principle}}{\GetTranslation{PluralPrinciple}}
\crefname{principles}{\GetTranslation{Principles}}{\GetTranslation{PluralPrinciples}}
\crefname{remark}{\GetTranslation{Remark}}{\GetTranslation{PluralRemarks}}
\crefname{remarks}{\GetTranslation{Remarks}}{\GetTranslation{PluralRemarks}}
\crefname{example}{\GetTranslation{Example}}{\GetTranslation{PluralExample}}
\crefname{examples}{\GetTranslation{Examples}}{\GetTranslation{PluralExamples}}

%----------------------------------------------------------------------------------------------------------------------
% making things pretty
%----------------------------------------------------------------------------------------------------------------------
\miniwrap{definition}{\definitioncolour}
\miniwrap{theorem}{\theoremcolour}
\miniwrap{proposition}{\theoremcolour}
\miniwrap{lemma}{\lemmacolour}
\miniwrap{corollary}{\corollarycolour}
\miniwrap{axiom}{\axiomcolour}
\miniwrap{axioms}{\axiomcolour}
\miniwrap{principle}{\principlecolour}
\miniwrap{principles}{\principlecolour}


%----------------------------------------------------------------------------------------------------------------------
% defining environment lists
%
% environment lists allow you to reference the item like Proposition 2.4 (ii) instead of (ii). Use them as such:
%
% \begin{theorem}
%
% \begin{theoremlist}
%   \item Something important \label{important_result}
%   \item Something important 2 \label{important_result_2}
% \end{theoremlist}
%
% \end{theorem}
%
% And to reference just use your preferred method, e.g. \Cref{important_result}.
%
% The following environment list are provided by prettytex:
%
% | environment name | Cref output (singular) | Cref output (plural) |
% |------------------|------------------------|----------------------|
% | theoremlist      | Theorem                | Theorems             |
% | lemmalist        | Lemma                  | Lemmas               |
% | corollarylist    | Corollary              | Corollarys           |
% | propositionlist  | Proposition            | Propositions         |
% | definitionlist   | Definition             | Definitions          |
% | axiomlist        | Axiom                  | Axioms               |
% | axiomslist       | Axiom                  | Axioms               |
% | principlelist    | Principle              | Principles           |
% | principleslist   | Principle              | Principles           |
% | remarklist       | Remark                 | Remarks              |
% | remarsklist      | Remark                 | Remarks              |
% | examplelist      | Example                | Examples             |
% | examplelist      | Example                | Examples             |
%
%----------------------------------------------------------------------------------------------------------------------
\envList{theorem}{\thetheorem}{\GetTranslation{Theorem}}
\envList{lemma}{\thelemma}{\GetTranslation{Lemma}}
\envList{corollary}{\thecorollary}{\GetTranslation{Corollary}}
\envList{proposition}{\theproposition}{\GetTranslation{Proposition}}
\envList{definition}{\thedefinition}{\GetTranslation{Definition}}
\envList{axiom}{\theaxiom}{\GetTranslation{Axiom}}
\envList{axioms}{\theaxioms}{\GetTranslation{Axiom}}
\envList{principle}{\theprinciple}{\GetTranslation{Principle}}
\envList{principles}{\theprinciples}{\GetTranslation{Principle}}
\envList{remark}{\theremark}{\GetTranslation{Remark}}
\envList{remarks}{\theremarks}{\GetTranslation{Remark}}
\envList{example}{\theexample}{\GetTranslation{Example}}
\envList{examples}{\theexamples}{\GetTranslation{Example}}